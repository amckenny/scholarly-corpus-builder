{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/scholarly-corpus.schema.json",
  "title": "Scholarly corpus configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "config_version", "enabled", "corpus_id", "display_name",
    "spreadsheet_key", "job_handle", "initial_load", "discovery", "processing", "screening",
    "incremental_updates"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "config_version": { "type": "integer", "minimum": 1 },
    "enabled": { "type": "boolean" },
    "corpus_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "display_name": { "type": "string", "minLength": 3, "maxLength": 120 },
    "spreadsheet_key": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "job_handle": { "type": "string", "format": "uuid" },
    "initial_load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lookback_years"],
      "properties": { "lookback_years": { "type": "integer", "minimum": 1, "maximum": 50 } }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_types", "rows_per_page", "journals", "query_families", "retrieval_gate"],
      "properties": {
        "source_types": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string" } },
        "rows_per_page": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "journals": {
          "type": "array", "minItems": 1, "maxItems": 50,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["journal", "issn"],
            "properties": {
              "journal": { "type": "string", "minLength": 3, "maxLength": 300 },
              "issn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{3}[0-9X]$" }
            }
          }
        },
        "query_families": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["query_id", "label", "query"],
            "properties": {
              "query_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,39}$" },
              "label": { "type": "string", "minLength": 3, "maxLength": 120 },
              "query": { "type": "string", "minLength": 3, "maxLength": 300 }
            }
          }
        },
        "retrieval_gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exclude_title_prefixes", "include_any_phrases", "include_all_groups"],
          "properties": {
            "exclude_title_prefixes": {
              "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 2, "maxLength": 200 }
            },
            "include_any_phrases": {
              "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 2, "maxLength": 200 }
            },
            "include_all_groups": {
              "type": "array", "maxItems": 50,
              "items": {
                "type": "array", "minItems": 2, "maxItems": 10,
                "items": { "type": "string", "minLength": 2, "maxLength": 200 }
              }
            }
          }
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification_batch_size", "continuation_delay_seconds", "max_backoff_seconds"],
      "properties": {
        "classification_batch_size": { "type": "integer", "minimum": 1, "maximum": 5 },
        "continuation_delay_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "max_backoff_seconds": { "type": "integer", "minimum": 30, "maximum": 86400 }
      }
    },
    "screening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "objective", "include_when", "exclude_when",
        "hard_exclusion_classification", "unresolved_classification", "classifications"
      ],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "objective": { "type": "string", "minLength": 20, "maxLength": 1000 },
        "include_when": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 3, "maxLength": 500 } },
        "exclude_when": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 3, "maxLength": 500 } },
        "hard_exclusion_classification": { "type": "string" },
        "unresolved_classification": { "type": "string" },
        "classifications": {
          "type": "array", "minItems": 2, "maxItems": 20,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "description", "disposition", "durable_exclusion", "unresolved"],
            "properties": {
              "id": { "type": "string", "pattern": "^(candidate|excluded)_[a-z0-9_]+$" },
              "description": { "type": "string", "minLength": 3, "maxLength": 500 },
              "disposition": { "enum": ["candidate", "excluded"] },
              "durable_exclusion": { "type": "boolean" },
              "unresolved": { "type": "boolean" }
            }
          }
        }
      }
    },
    "incremental_updates": {
      "type": "object", "additionalProperties": false,
      "required": ["overlap_days", "minimum_gap_days"],
      "properties": {
        "overlap_days": { "type": "integer", "minimum": 1, "maximum": 365 },
        "minimum_gap_days": { "type": "integer", "minimum": 1, "maximum": 365 }
      }
    }
  }
}
